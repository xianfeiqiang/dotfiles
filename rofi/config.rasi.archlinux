configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: " Apps";
    display-run: " Run";
    display-window: " Window";

    font: "JetBrainsMono Nerd Font 11";

    drun-display-format: "{icon} {name}";
    disable-history: false;
    width: 30;
    lines: 8;
    padding: 10;
    cycle: true;
    case-sensitive: false;

}
@theme "~/.config/rofi/theme.rasi"
